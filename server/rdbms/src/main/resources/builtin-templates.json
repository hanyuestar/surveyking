  {
    "serialNo": "BUILTIN-001",
    "name": "客户满意度调查",
    "questionType": "Survey",
    "mode": "survey",
    "category": "满意度调查",
    "tag": ["内置样例"],
    "shared": 1,
    "priority": 10,
    "template": {
      "id": "root",
      "title": "客户满意度调查",
      "description": "感谢您使用我们的产品/服务，请花 1 分钟为本次体验打分，您的反馈将帮助我们做得更好。",
      "type": "Survey",
      "attribute": { "mode": "survey" },
      "children": [
        {
          "id": "q1",
          "title": "您对我们的整体满意度",
          "type": "Score",
          "attribute": { "required": true, "scoreStyle": "star", "numericScale": 5 }
        },
        {
          "id": "q2",
          "title": "您最满意的是哪一方面？",
          "type": "Radio",
          "attribute": { "required": true },
          "children": [
            { "id": "q2_1", "type": "Option", "title": "产品质量" },
            { "id": "q2_2", "type": "Option", "title": "服务态度" },
            { "id": "q2_3", "type": "Option", "title": "价格性价比" },
            { "id": "q2_4", "type": "Option", "title": "售后支持" }
          ]
        },
        {
          "id": "q3",
          "title": "您希望我们优先改进哪些方面？（可多选）",
          "type": "Checkbox",
          "attribute": { "required": false },
          "children": [
            { "id": "q3_1", "type": "Option", "title": "响应速度" },
            { "id": "q3_2", "type": "Option", "title": "产品功能" },
            { "id": "q3_3", "type": "Option", "title": "价格体系" },
            { "id": "q3_4", "type": "Option", "title": "使用体验" }
          ]
        },
        {
          "id": "q4",
          "title": "其他建议或意见",
          "type": "Textarea",
          "attribute": { "required": false }
        },
        {
          "id": "q5",
          "title": "邮箱（选填，用于回访）",
          "type": "FillBlank",
          "attribute": { "required": false, "dataType": "email" }
        }
      ]
    }
  },
